{
  "name": "@byos/react",
  "version": "0.1.0",
  "description": "Bring-your-own-subscription React UI: device-code sign-in, model and effort picker, AI pill, and headless hooks. Themed per site through --byos-* CSS variables.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "test": "npm run build && node --experimental-strip-types --test src/*.test.ts",
    "css": "python3 src/build-css.py src/styles.src.css src/styles.css"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@byos/core": "file:../byos-core"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.9.3"
  }
}
